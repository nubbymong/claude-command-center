# Dependencies & build output
node_modules/
out/
dist/
*.exe

# Secrets & credentials
.secrets/
.env

# Personal/local config. `.claude/*` (not `.claude/`) so the shared, repo-owned
# agent skills under .claude/skills/ can be un-ignored below; git will not
# descend into a wholly-excluded directory. Everything else in .claude/ --
# settings.local.json, session state, caches -- stays personal and untracked.
# (ADR-009 / 2026-07-30, same reasoning as ADR-004 tracking AGENTS.md.)
.claude/*
!.claude/skills/
.agents/
# AGENTS.md is now TRACKED — it is the canonical, cross-tool agent brief
# (ADR-004 / 2026-07-18). CLAUDE.md imports it via `@AGENTS.md`.
.copilot-review-notes.md
.superpowers/
docs/superpowers/
USER/
/memory/
.pr30-body.md
.pr*-body.md
docs/release-prep/
scripts/probe-transcript-path.md

# Build cache
*.tsbuildinfo

# Release artifacts (generated by release.js)
RELEASE_NOTES.md
CHECKSUMS.txt

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
nul
# PowerShell module-analysis cache (written to CWD when LOCALAPPDATA is redirected)
Microsoft/

# Test artifacts
test-results/

# Temp/debug files
*.ps1
*.log
process-snapshot-*.txt
.tip-screenshots/
.tmp-e2e/

# CARP running log: CONTEXT.md is a GENERATED aggregate of CONTEXT.d/ fragments
# (rendered on demand); never commit it. The fragments under CONTEXT.d/ are the
# sole tracked source. (aai-core AAI-407 / ADR-043 convention, mirrored here.)
/CONTEXT.md
