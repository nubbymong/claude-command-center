# Dependencies & build output
node_modules/
out/
dist/
*.exe

# Secrets & credentials
.secrets/
.env

# Personal/local config. `.claude/*` (not `.claude/`) so the shared, repo-owned
# agent skills under .claude/skills/ can be un-ignored below; git will not
# descend into a wholly-excluded directory. Everything else in .claude/ --
# settings.local.json, session state, caches -- stays personal and untracked.
# (ADR-009 / 2026-07-30, same reasoning as ADR-004 tracking AGENTS.md.)
.claude/*
!.claude/skills/
# settings.json is repo-owned too: it carries the session-isolation PreToolUse
# hook that every worktree must inherit (ADR-012). An untracked hook protects
# nobody but the machine that wrote it. settings.local.json stays personal.
!.claude/settings.json
.agents/
# AGENTS.md is now TRACKED — it is the canonical, cross-tool agent brief
# (ADR-004 / 2026-07-18). CLAUDE.md imports it via `@AGENTS.md`.
.copilot-review-notes.md
.superpowers/
docs/superpowers/
USER/
/memory/
.pr30-body.md
.pr*-body.md
docs/release-prep/
scripts/probe-transcript-path.md

# Build cache
*.tsbuildinfo

# Release artifacts (generated by release.js)
RELEASE_NOTES.md
CHECKSUMS.txt

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
nul
# PowerShell module-analysis cache (written to CWD when LOCALAPPDATA is redirected)
Microsoft/

# Test artifacts
test-results/

# Temp/debug files
*.ps1
*.log
process-snapshot-*.txt
.tip-screenshots/
.tmp-e2e/

# CARP running log: CONTEXT.md is a GENERATED aggregate of CONTEXT.d/ fragments
# (rendered on demand); never commit it. The fragments under CONTEXT.d/ are the
# sole tracked source. (aai-core AAI-407 / ADR-043 convention, mirrored here.)
/CONTEXT.md

# Code-signing certificates / private keys — NEVER commit these. Sign locally via
# env vars pointing at a cert OUTSIDE the repo, or via CI secrets. (Belt-and-braces.)
*.pfx
*.p12
*.key
*.pem
*.p8
*.cer
*.crt
*.jks
# Any base64-wrapped cert/key blob (e.g. the `cert.b64` used to load a GitHub
# secret — see docs/code-signing.md). Make those outside the repo; catch anyway.
*.b64

# Vitest transform cache. Per-checkout when vitest.config.ts sets cacheDir, so
# worktrees sharing a junctioned node_modules cannot serve each other stale
# transforms. Ignored unconditionally so a leftover dir can never be committed.
.vite-cache/
# Mockups written for the Agent Canvas. `.ccc-canvas/` is the folder the canvas
# skill names, and the canvas serves ONLY this session's project folder or its
# worktree — so an agent following the skill necessarily leaves files inside the
# repo. Ignored so following the instructions cannot dirty the tree, and so the
# scratch folder never has to be committed to be rendered.
# `.canvas-scratch/` is the older spelling, kept ignored for existing checkouts.
.ccc-canvas/
.canvas-scratch/
