{
  "name": "claude-conductor",
  "version": "2.0.0",
  "description": "Multi-session Claude Code terminal orchestrator",
  "author": "Nicholas Moger",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win --dir",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "verify:package": "node scripts/verify-native-unpack.mjs",
    "test": "vitest run && npm run test:unit:native && npx playwright test",
    "test:unit": "vitest run",
    "test:unit:native": "node scripts/run-native-tests.mjs",
    "test:e2e": "npx playwright test",
    "release": "node scripts/release.js",
    "promote": "node scripts/promote.js",
    "update-server": "node scripts/update-server.js",
    "postinstall": "electron-rebuild --only=node-pty,better-sqlite3",
    "rebuild": "electron-rebuild",
    "capture-training": "npx tsx scripts/capture-training-screenshots.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:minimal": "electron test/minimal/main.js"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "12.10.1",
    "chrome-remote-interface": "^0.34.0",
    "dompurify": "^3.4.12",
    "electron-screenshots": "^0.6.1",
    "marked": "^18.0.5",
    "node-pty": "1.2.0-beta.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "electron": "42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "hono": "^4.12.21",
    "@hono/node-server": "^1.19.14",
    "lodash-es": "^4.18.1",
    "ip-address": "^10.2.0",
    "@xmldom/xmldom": "^0.8.13",
    "minimatch": "^10.2.3",
    "tar": "^7.5.11",
    "lodash": "^4.18.0",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "rollup": "^4.59.0",
    "@tootallnate/once": "^3.0.1",
    "nanoid": "^5.1.11",
    "fast-uri": "^3.1.5",
    "mermaid": "^11.15.0",
    "qs": "^6.15.2",
    "uuid": "^11.1.1",
    "tmp": "^0.2.6",
    "chrome-remote-interface": {
      "ws": "^7.5.11"
    }
  },
  "build": {
    "appId": "com.claudeconductor.app",
    "productName": "Claude Command Center",
    "files": [
      "out/**/*",
      "resources/**/*",
      "scripts/resume-picker.js",
      "scripts/codex-resume-picker.js",
      "scripts/lib/codex-resume-picker-lib.js",
      "scripts/vision-cli.js",
      "scripts/vision-prompt.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "ClaudeCommandCenter-${version}-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Command Center",
      "runAfterFinish": true,
      "uninstallDisplayName": "Claude Command Center",
      "artifactName": "ClaudeCommandCenter-${version}.${ext}"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "build/config-template.json",
        "to": "config-template.json"
      },
      {
        "from": "splash.png",
        "to": "splash.png"
      }
    ]
  }
}
